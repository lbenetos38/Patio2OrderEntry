      /*
		    Εαν θελουμε απομονώνουμε το συστημα απο τις πραγματικες βασεις. Δεν γραφεται τίποτα σε καμμία βάση.
		    Οι evaluators τρεχουν, αλλα χρησιμοποιον ena dummy Datalayer
		    ΠΑΡΑΓΩΓΗ: false
      */
      "DisableDataLayer": false,
      /*
        ETS, ORA,*
      */
      "TargetConnection": "ETS",
      /*
        Μετατρεπει τα πεδια τύπου UTCTimestamp/UTCTimeOnly σε Greek Standard (Local) Time
      */
