		    εδω ενεργοποιούμε τον εσωτερικο emulator παραγει events, ετσι ωστε να αποκοπούμε απο το ATHEX Gateway
		    ΠΑΡΑΓΩΓΗ: false
      */
      "Enable": false,
      "EmulateMessages": true,
      /*
        milliseconds
      */
      "EmulatePausePeriod": 0,
      "MessagesLoops": 0,
      "FixMessagesFile": "E:\\Projects\\Patio2FixClients\\PatioFIX.Admin\\TestFiles\\FIX_MESSAGES_IN_00.txt"
    },

    "SimpleSchedule": {
      /*
			  To προγραμμα λειτουργίας του service. Αυτες τις ωρες προσπαθει o theController να συνδεθει στον
			  ATHEX GW και να εκτελεσει αποστολη και ληψη μηνυματων.
			  (Οι τιμες στο value πρεπει να εχουν αυστηρα το format που φαινεται (ειναι 24h της μορφης hh:mm))
			  ΠΑΡΑΓΩΓΗ: DISABLED
	   */
      "Disable": true,
      "Monday": "10:00-17:15",
      "Tuesday": "10:00-17:15",
      "Wednesday": "10:00-17:15",
      "Thursday": "10:00-17:15",
      "Friday": "10:00-17:15",
      "Saturday": "",
